# BEFO environment. Generated from scripts/env-spec.ts by `pnpm env:example`.
# .env is git-ignored. Never commit real values. Check with `pnpm env:check`.

############################################################
# A. FRONTEND (public values, safe in the browser)
############################################################

# [REQUIRED]
#  Product name shown everywhere. Decided at Gate G0.
VITE_APP_NAME=BEFO

# [REQUIRED]
#  1) Public site URL, no trailing slash.
#  2) Dev: http://localhost:5173 · Prod: https://your-domain
VITE_APP_URL=http://localhost:5173

# [REQUIRED]
#  1) "demo" = public site runs on built-in example places, no backend needed (login disabled).
#  2) "supabase" = real data. Switch to this once VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are set.
VITE_DATA_SOURCE=demo

# [REQUIRED for prod]
#  1) supabase.com/dashboard → open your project
#  2) Click Connect (top bar), or Project Settings → Data API
#  3) Copy the Project URL (looks like https://abcd1234.supabase.co)
#  Format: https://abcd1234.supabase.co
#  Docs: https://supabase.com/docs/guides/api/api-keys
VITE_SUPABASE_URL=

# [REQUIRED for prod]
#  1) Project Settings → API Keys → tab "Publishable and secret API keys"
#  2) Copy the PUBLISHABLE key (starts with sb_publishable_). Safe for browsers.
#  3) (The old "anon" key also works, but Supabase is retiring legacy keys by the end of 2026.)
#  Format: sb_publishable_...
#  Docs: https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
VITE_SUPABASE_ANON_KEY=

# [REQUIRED for prod]
#  Support WhatsApp number: digits only, with country code.
#  Format: 919876543210
VITE_SUPPORT_WHATSAPP=

# [REQUIRED for prod]
#  Support email shown on the site.
#  Format: help@your-domain
VITE_SUPPORT_EMAIL=

# [REQUIRED for prod]
#  1) dash.cloudflare.com → Turnstile → Add widget
#  2) Add your domains (and localhost for testing) → widget mode Managed → Create
#  3) Copy the Site key here
#  4) Copy the Secret key into Supabase: Authentication → Attack Protection → Enable CAPTCHA → provider Turnstile → paste → Save
#  Docs: https://developers.cloudflare.com/turnstile/get-started/
VITE_TURNSTILE_SITE_KEY=

# [REQUIRED for push notifications]
#  1) Run: npx web-push generate-vapid-keys
#  2) Copy "Public Key" here
#  3) Copy "Private Key" into VAPID_PRIVATE_KEY (group D)
VITE_VAPID_PUBLIC_KEY=

# [OPTIONAL]
#  Map tiles. The OpenStreetMap default is fine for low traffic only (see docs/DECISIONS.md, OSM tile policy).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# [OPTIONAL]
#  Error tracking: sentry.io → Project → Settings → Client Keys (DSN) → copy
VITE_SENTRY_DSN=

############################################################
# B. SUPABASE / AUTH (server side — never in the browser)
############################################################

# [REQUIRED for prod]
#  Same value as VITE_SUPABASE_URL. Used by scripts. (Hosted Edge Functions get it automatically.)
SUPABASE_URL=

# [REQUIRED for prod]
#  1) Project Settings → API Keys → "Publishable and secret API keys" → Secret keys → reveal and copy (starts with sb_secret_)
#  2) NEVER put this in the browser, in Cloudflare Pages variables, or in git.
#  Format: sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=

# [REQUIRED for prod]
#  1) console.cloud.google.com → create or select a project
#  2) Google Auth Platform (or APIs & Services → OAuth consent screen) → Get started → app name, support email → Audience: External → save
#  3) Branding → add your domain under Authorized domains; later click "Publish app" so anyone can log in
#  4) Clients → Create client → Web application
#  5) Authorized redirect URI: https://<PROJECT-REF>.supabase.co/auth/v1/callback (local Supabase: http://127.0.0.1:54321/auth/v1/callback)
#  6) Copy Client ID and Client secret here, then paste both in Supabase: Authentication → Sign In / Providers → Google → enable → Save
#  7) Supabase: Authentication → URL Configuration → set Site URL and add Redirect URLs (prod + http://localhost:5173/**)
#  Docs: https://supabase.com/docs/guides/auth/social-login/auth-google
GOOGLE_OAUTH_CLIENT_ID=

# [REQUIRED for prod]
#  See GOOGLE_OAUTH_CLIENT_ID. Only pasted into the Supabase dashboard; kept here for your records.
GOOGLE_OAUTH_CLIENT_SECRET=

# [REQUIRED for prod] (server secret → pnpm env:push-supabase)
#  1) Deploy the function: supabase functions deploy sms-hook --no-verify-jwt
#  2) Supabase → Authentication → Hooks → Send SMS hook → type HTTPS → paste the function URL
#  3) Click Generate secret → copy the WHOLE value (looks like v1,whsec_abc...) here — the function strips the prefix itself
#  4) Enable the hook. Also enable the Phone provider (Authentication → Sign In / Providers → Phone).
#  Docs: https://supabase.com/docs/guides/auth/auth-hooks/send-sms-hook
SEND_SMS_HOOK_SECRET=

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  "console" prints the OTP in the function logs (dev only). "msg91" sends real SMS.
SMS_DRIVER=console

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Max SMS the whole platform may send per day (cost safety).
SMS_DAILY_CAP=300

# [REQUIRED for real SMS] (server secret → pnpm env:push-supabase)
#  1) msg91.com → sign up and finish KYC
#  2) Register on a DLT portal (Jio / Airtel / Vi / BSNL): entity → sender ID (6 letters, matches your brand) → OTP content template
#  3) Template suggestion: "##OTP## is your login code for BEFO. Do not share it with anyone." (DLT approval takes 1–3 days; start early)
#  4) MSG91 dashboard → add the approved DLT template → note its Template ID
#  5) MSG91 → API / Authkey section → create or copy the Authkey
#  Docs: https://docs.msg91.com/
MSG91_AUTH_KEY=

# [REQUIRED for real SMS] (server secret → pnpm env:push-supabase)
#  The 6-letter DLT sender ID (header).
MSG91_SENDER_ID=

# [REQUIRED for real SMS] (server secret → pnpm env:push-supabase)
#  MSG91 template ID for the OTP message.
MSG91_TEMPLATE_ID=

# [REQUIRED for real SMS] (server secret → pnpm env:push-supabase)
#  DLT template ID from the operator portal (19 digits).
MSG91_DLT_TEMPLATE_ID=

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  1) Your domain only, no https:// and no path (e.g. befo.in). Dev: localhost.
#  2) Changing it later breaks every saved fingerprint card. Decide at Gate G0.
WEBAUTHN_RP_ID=localhost

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Name shown in the fingerprint prompt (usually the product name).
WEBAUTHN_RP_NAME=BEFO

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Comma-separated origins allowed to use passkeys, e.g. https://befo.in,https://www.befo.in
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  How long the ID card stays open after a fingerprint.
CARD_UNLOCK_SECONDS=60

# [REQUIRED for prod] (server secret → pnpm env:push-supabase)
#  Comma-separated emails of platform admins (verified email). Then run: pnpm admin:add
PLATFORM_ADMIN_EMAILS=

# [REQUIRED for prod] (server secret → pnpm env:push-supabase)
#  Comma-separated admin phones, e.g. +919876543210
PLATFORM_ADMIN_PHONES=

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Default member cap for new places.
DEFAULT_MAX_MEMBERS=100

############################################################
# C. AI (bill reading, voice entry)
############################################################

# [REQUIRED for Smart Capture (real AI)] (server secret → pnpm env:push-supabase)
#  1) console.anthropic.com → sign up
#  2) Settings → Billing → add credit and set a monthly spend limit
#  3) API Keys → Create key → copy here
#  Docs: https://docs.claude.com/en/api/overview
ANTHROPIC_API_KEY=

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  "fixture" = canned results for dev/CI (no key needed). "anthropic" = real AI.
AI_DRIVER=fixture

# [REQUIRED for Smart Capture (real AI)] (server secret → pnpm env:push-supabase)
#  Model for everyday bills. Check the current model names at docs.claude.com → Models overview.
AI_MODEL_FAST=claude-haiku-5-5

# [REQUIRED for Smart Capture (real AI)] (server secret → pnpm env:push-supabase)
#  Model used to retry low-confidence bills.
AI_MODEL_STRONG=claude-sonnet-5-5

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Safety limit per place per day.
AI_DAILY_DOCS_PER_TENANT=60

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Safety limit per place per month.
AI_MONTHLY_DOCS_PER_TENANT=1000

# [REQUIRED] (server secret → pnpm env:push-supabase)
#  Largest bill file accepted, in MB.
AI_MAX_FILE_MB=8

############################################################
# D. NOTIFICATIONS
############################################################

# [REQUIRED for push notifications] (server secret → pnpm env:push-supabase)
#  See VITE_VAPID_PUBLIC_KEY (group A).
VAPID_PRIVATE_KEY=

# [REQUIRED for push notifications] (server secret → pnpm env:push-supabase)
#  mailto: address push services can contact, e.g. mailto:help@your-domain
VAPID_SUBJECT=mailto:you@example.com

# [REQUIRED for email] (server secret → pnpm env:push-supabase)
#  1) resend.com → sign up
#  2) Domains → Add domain → add the DNS records it shows (SPF, DKIM) at your domain provider → wait for Verified
#  3) API Keys → Create API key (Sending access) → copy here
#  Docs: https://resend.com/docs
RESEND_API_KEY=

# [REQUIRED for email] (server secret → pnpm env:push-supabase)
#  Sender, e.g. "BEFO <hello@your-domain>" (domain must be verified in Resend).
EMAIL_FROM="BEFO <hello@example.com>"

############################################################
# E. CLOUDFLARE PAGES VARIABLES (set in Pages → Settings → Variables and Secrets)
############################################################

# [REQUIRED for prod]
#  Same as VITE_APP_URL. Set in Cloudflare Pages → your project → Settings → Variables and Secrets.
SITE_URL=

# [REQUIRED for prod]
#  Same as VITE_SUPABASE_ANON_KEY (publishable key). NEVER the secret/service key here.
SUPABASE_ANON_KEY=

############################################################
# F. BACKUPS + CI (GitHub → repo → Settings → Secrets and variables → Actions)
############################################################

# [REQUIRED for prod]
#  1) Supabase → Connect → "Session pooler" → copy the URI (GitHub runners are IPv4-only, so use the pooler)
#  2) Replace [YOUR-PASSWORD] (reset it in Project Settings → Database if forgotten)
SUPABASE_DB_URL=

# [REQUIRED for prod]
#  1) Cloudflare → R2 Object Storage → Create bucket (e.g. befo-backups)
#  2) Account ID is shown on the R2 overview page
#  Docs: https://developers.cloudflare.com/r2/api/tokens/
R2_ACCOUNT_ID=

# [REQUIRED for prod]
#  1) R2 → Manage API tokens → Create API token → Object Read & Write → limit to the backup bucket → Create
#  2) Copy Access Key ID here
R2_ACCESS_KEY_ID=

# [REQUIRED for prod]
#  Shown once on the same screen as R2_ACCESS_KEY_ID.
R2_SECRET_ACCESS_KEY=

# [REQUIRED for prod]
#  The bucket name you created.
R2_BUCKET=

# [REQUIRED for prod]
#  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# [REQUIRED]
#  Delete backups older than this.
BACKUP_RETENTION_DAYS=30

# [REQUIRED for prod]
#  URL of the backup-heartbeat Edge Function: https://<PROJECT-REF>.supabase.co/functions/v1/backup-heartbeat
BACKUP_HEARTBEAT_URL=

# [REQUIRED for prod] (server secret → pnpm env:push-supabase)
#  Any long random string (e.g. openssl rand -hex 32). Same value in GitHub secrets and Supabase secrets.
BACKUP_HEARTBEAT_SECRET=

# [OPTIONAL]
#  CI deploys: supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=

# [OPTIONAL]
#  The code in your project URL (https://<PROJECT-REF>.supabase.co)
SUPABASE_PROJECT_REF=

# [OPTIONAL]
#  Project Settings → Database → database password
SUPABASE_DB_PASSWORD=

# [OPTIONAL]
#  Cloudflare → My Profile → API Tokens → Create Token → template "Edit Cloudflare Workers" or a custom token with Cloudflare Pages: Edit
CLOUDFLARE_API_TOKEN=

# [OPTIONAL]
#  Cloudflare dashboard → Workers & Pages overview → Account ID (right sidebar)
CLOUDFLARE_ACCOUNT_ID=
